APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LLM_PROVIDER=gemini
# Default Gemini model; override only with a model listed by GET /api/llm/models.
LLM_MODEL=gemini-3.5-flash-lite
# Put real credentials only in .env. Never commit or share that file.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Optional generic fallback only when intentionally using a single provider:
LLM_API_KEY=
FORMAL_RUNNER_MODE=auto
WSL_DISTRO=Ubuntu
HDL_FRONTEND_MODE=auto
# Optional; defaults to backend/../formal/runs
FORMAL_RUNS_DIR=
